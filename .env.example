# --- Monorepo Shared Environment Configuration ---

# Node Environment
NODE_ENV=development

# --- Database (@lastmile/db) ---
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# --- Super Admin Credentials (for db:seed) ---
ADMIN_EMAIL=admin@sapcone.org
ADMIN_PASSWORD=SuperSecretAdminPassword123!
API_URL=http://localhost:8000

# --- Better Auth & JWT (@lastmile/auth & apps/api) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_APP_URL=http://localhost:8081
JWT_SECRET=super-secret-jwt-key-change-in-production-2026

# --- API Service (apps/api) ---
PORT=8000
FRONTEND_URL=http://localhost:3000

# --- Admin Web Frontend (apps/admin-web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Africa's Talking SMS Services (apps/api & apps/participant-channels) ---
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
