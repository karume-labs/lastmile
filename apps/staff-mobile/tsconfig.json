{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "../..",
    "paths": {
      "@lastmile/types/*": [
        "packages/types/src/*"
      ],
      "@lastmile/validators/*": [
        "packages/validators/src/*"
      ],
      "@/*": [
        "apps/staff-mobile/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
