# --- LastMile API Environment Configuration ---

# Server
PORT=8000
NODE_ENV=development

# CORS - URL of the admin web app
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated additional CORS origins (e.g. for LAN access: http://192.168.1.100:3000)
CORS_ORIGINS=

# Database — consumed by @lastmile/db (also set in packages/db/.env)
DATABASE_URL=file:../../local.db
DATABASE_AUTH_TOKEN=

# Auth — consumed by @lastmile/auth
JWT_SECRET=super-secret-jwt-key-change-in-production-2026

# Africa's Talking (SMS) — consumed directly via process.env
AT_USERNAME=sandbox
AT_API_KEY=


# Kotani pay
KOTANI_API_KEY=your_copied_api_key_here
KOTANI_API_SECRET=your_copied_secret_here
