{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@lastmile/db/*": ["packages/db/src/*"],
      "@lastmile/db/schemas/auth": ["packages/db/src/auth/schema/index.ts"],
      "@lastmile/db/schemas/identity": ["packages/db/src/identity/schema/index.ts"],
      "@lastmile/db/schemas/registration": ["packages/db/src/registration/schema/index.ts"],
      "@lastmile/db/schemas/programmes": ["packages/db/src/programmes/schema/index.ts"],
      "@lastmile/validators/shared": ["packages/validators/src/shared.ts"],
      "@lastmile/validators/auth": ["packages/validators/src/auth.ts"],
      "@lastmile/validators/registration": ["packages/validators/src/registration.ts"],
      "@lastmile/validators/programmes": ["packages/validators/src/programmes.ts"],
      "@lastmile/validators/ussd": ["packages/validators/src/ussd.ts"],
      "@lastmile/validators/offramp": ["packages/validators/src/offramp.ts"],
      "@lastmile/types/api": ["packages/types/src/api.ts"],
      "@lastmile/types/auth": ["packages/types/src/auth.ts"],
      "@lastmile/types/registration": ["packages/types/src/registration.ts"],
      "@lastmile/types/programmes": ["packages/types/src/programmes.ts"],
      "@lastmile/types/ussd": ["packages/types/src/ussd.ts"],
      "@lastmile/types/offramp": ["packages/types/src/offramp.ts"],
      "@lastmile/auth/*": ["packages/auth/src/*"],
      "@lastmile/api/*": ["apps/api/src/*"],
      "@lastmile/participant-ussd": ["apps/participant-ussd/src/index.ts"],
      "@lastmile/*": ["packages/*/src/index.ts"]
    }
  }
}
