{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@lastmile/db/*": ["packages/db/src/*"],
      "@lastmile/auth/*": ["packages/auth/src/*"],
      "@lastmile/api/*": ["apps/api/src/*"],
      "@lastmile/*": ["packages/*/src/index.ts"]
    }
  },
  "include": ["apps/api/**/*.ts", "packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "apps/admin-web", "apps/staff-mobile", "**/dist", "**/build"]
}
