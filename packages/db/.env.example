# --- @lastmile/db Environment Configuration ---

# Database connection URL (local SQLite or Turso/remote LibSQL)
DATABASE_URL=file:../../local.db
DATABASE_AUTH_TOKEN=

# Super Admin seeding credentials (used by `bun run db:seed` or `db:seed:admin`)
# These are optional — seeding is skipped if not set
ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD="#Default123"

# URL of the API server (used during seeding to register the admin via Better Auth)
API_URL=http://localhost:8000

NODE_ENV=development
