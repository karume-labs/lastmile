{
  "name": "sapcone-lastmile",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' --parallel dev",
    "build": "bun run --filter './apps/*' --parallel build",
    "dev:web": "bun --cwd apps/admin-web dev",
    "build:web": "bun --cwd apps/admin-web build",
    "db:generate": "bun --cwd packages/db db:generate",
    "db:push": "bun --cwd packages/db db:push",
    "db:migrate": "bun --cwd packages/db db:migrate",
    "db:studio": "bun --cwd packages/db db:studio",
    "db:seed": "bun --cwd packages/db db:seed",
    "db:generate-auth": "bun --cwd packages/auth db:generate-auth",
    "typecheck": "bun run --filter '*' typecheck",
    "ui:web": "bunx shadcn@latest add --cwd apps/admin-web",
    "reinstall": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + || true; rm -f bun.lock; bun install"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/plugin-transform-react-jsx-development": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@biomejs/biome": "2.2.0",
    "@types/node": "^20",
    "@types/react": "^19"
  }
}
