{
  "name": "sapcone-lastmile",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' --parallel dev",
    "build": "bun run --filter './apps/*' --parallel build",
    "dev:web": "bun --cwd apps/admin-web dev",
    "build:web": "bun --cwd apps/admin-web build",
    "dev:mobile": "bun --cwd apps/staff-mobile dev",
    "build:mobile": "bun --cwd apps/staff-mobile build",
    "android:mobile": "bun --cwd apps/staff-mobile android",
    "ios:mobile": "bun --cwd apps/staff-mobile ios",
    "db:generate": "bun --cwd packages/db db:generate",
    "db:push": "bun --cwd packages/db db:push",
    "db:migrate": "bun --cwd packages/db db:migrate",
    "db:studio": "bun --cwd packages/db db:studio",
    "db:seed": "bun --cwd packages/db db:seed",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
